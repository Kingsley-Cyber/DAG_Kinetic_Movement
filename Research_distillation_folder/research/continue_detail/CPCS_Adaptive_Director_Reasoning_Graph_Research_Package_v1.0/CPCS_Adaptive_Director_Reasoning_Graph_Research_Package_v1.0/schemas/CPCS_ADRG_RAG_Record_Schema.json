{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cpcs-adrg/1.0/rag-record.schema.json",
  "title": "CPCS ADRG RAG Record",
  "type": "object",
  "required": ["record_id", "record_type", "document_id", "title", "text", "source_hash"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["document", "paper_chunk", "source"]},
    "document_id": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "chunk_index": {"type": "integer", "minimum": 0},
    "text": {"type": "string", "minLength": 1},
    "context_before": {"type": "string"},
    "summary": {"type": "string"},
    "concepts": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"pattern": "^S[0-9]{3}$"}},
    "evidence_labels": {
      "type": "array",
      "items": {"enum": ["ESTABLISHED", "EMERGING", "PROPOSED", "OPERATIONALIZATION", "PROJECT-OBSERVED", "CAUTION"]}
    },
    "anchors": {"type": "array", "items": {"type": "string"}},
    "word_count": {"type": "integer", "minimum": 0},
    "estimated_tokens": {"type": "integer", "minimum": 0},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
