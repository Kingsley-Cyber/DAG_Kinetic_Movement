{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cpcs-adrg/1.0/reasoning-graph.schema.json",
  "title": "CPCS Adaptive Director Reasoning Graph",
  "type": "object",
  "required": ["schema_version", "document_id", "planner_profile", "nodes", "edges", "provenance"],
  "properties": {
    "schema_version": {"const": "cpcs-adrg/1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "planner_profile": {"type": "string", "minLength": 1},
    "request_id": {"type": "string"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decisionRecord"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "unresolved": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "additionalProperties": false,
  "$defs": {
    "budgets": {
      "type": "object",
      "properties": {
        "maximum_context_tokens": {"type": "integer", "minimum": 1},
        "maximum_output_tokens": {"type": "integer", "minimum": 1},
        "retrieval_top_k": {"type": "integer", "minimum": 1},
        "branch_width": {"type": "integer", "minimum": 1},
        "branch_depth": {"type": "integer", "minimum": 0},
        "critic_passes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "project": {"type": ["string", "null"]},
        "sequence": {"type": ["string", "null"]},
        "scene": {"type": ["string", "null"]},
        "shot": {"type": ["string", "null"]},
        "beat": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["created_at"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "model_profile": {"type": "string"},
        "prompt_digest": {"type": "string"},
        "compiler_version": {"type": "string"},
        "source_refs": {"type": "array", "items": {"type": "string"}},
        "source_digests": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "plane", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "goal", "constraint", "question", "retrieval_query", "evidence_result",
            "candidate", "decision", "transform", "compile_mapping", "validation",
            "failure", "repair", "metric", "experiment", "artifact", "model_policy",
            "budget", "branch", "merge"
          ]
        },
        "plane": {
          "enum": [
            "knowledge_evidence", "scene_intent_control", "reasoning_execution",
            "compilation_realization", "verification_experiment"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["planned", "ready", "running", "resolved", "blocked", "failed", "repaired", "revalidated", "superseded"]
        },
        "scope": {"$ref": "#/$defs/scope"},
        "authority": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "selected_candidate": {"type": "string"},
        "payload": {"type": ["object", "array", "string", "number", "boolean", "null"]},
        "acceptance": {"type": "object"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "pairs_with", "conflicts_with", "supported_by", "contradicted_by", "sourced_from",
            "alias_of", "specializes", "decomposes_to", "depends_on", "grounds", "proposes",
            "variant_of", "selected_over", "rejected_because", "aggregates", "requires_tool",
            "precedes", "overlaps", "triggers", "synchronizes_with", "targets", "contacts",
            "observed_by", "preserves", "compiled_to", "native_exact", "native_approximate",
            "baked_into_reference", "compressed_to_text", "postprocess_only", "evaluation_only",
            "dropped_with_warning", "unsupported_error", "validated_by", "passes", "fails",
            "caused_by", "mitigated_by", "repaired_by", "revalidated_by", "measured_by",
            "compared_with", "promotes"
          ]
        },
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string"},
        "target_adapter": {"type": "string"},
        "realization_status": {
          "enum": [
            "native_exact", "native_approximate", "baked_into_reference", "compressed_to_text",
            "postprocess_only", "evaluation_only", "dropped_with_warning", "unsupported_error"
          ]
        },
        "metadata": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "selected_over"}}},
          "then": {"required": ["decision_id"]}
        },
        {
          "if": {"properties": {"type": {"const": "compiled_to"}}},
          "then": {"required": ["target_adapter", "realization_status"]}
        }
      ],
      "additionalProperties": false
    },
    "decisionRecord": {
      "type": "object",
      "required": ["decision_id", "question", "alternatives", "selected", "criteria", "confidence"],
      "properties": {
        "decision_id": {"type": "string"},
        "question": {"type": "string"},
        "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "criteria": {"type": "array", "items": {"type": "string"}},
        "scores": {"type": "object"},
        "selected": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "unresolved": {"type": "array", "items": {"type": "string"}},
        "loss": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
