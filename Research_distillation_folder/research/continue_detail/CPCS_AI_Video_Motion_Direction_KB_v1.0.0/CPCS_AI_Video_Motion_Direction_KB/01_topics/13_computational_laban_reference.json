  "proposed_detector": {
    "stages": [
      "video decode + camera stabilization",
      "multi-person tracking",
      "2D whole-body pose",
      "3D lifting/triangulation",
      "body-scale normalization",
      "contact and support inference",
      "kinematic feature bank",
      "BESS factor heads",
      "temporal smoothing/state model",
      "expert-calibrated uncertainty",
      "explanation/provenance output"
    ],
    "factor_heads": {
      "space": [
        "path directness",
        "reach",
        "level",
        "direction",
        "kinesphere",
        "planes"
      ],
      "time": [
        "duration",
        "time-to-peak",
        "acceleration"
      ],
      "shape": [
        "axis expansion/contraction",
        "directional/carving proxies"
      ],
      "body": [
        "initiation",
        "sequencing",
        "participation",
        "connectivity"
      ],
      "weight": [
        "effective mass/support/energy/target response proxies"
      ],
      "flow": [
        "braking, reversibility, jerk/control, continuation proxies"
      ]
    },
    "training": "multi-task ordinal/continuous labels + coder disagreement distribution",
    "output": "probability distributions, not hard labels"
  },
