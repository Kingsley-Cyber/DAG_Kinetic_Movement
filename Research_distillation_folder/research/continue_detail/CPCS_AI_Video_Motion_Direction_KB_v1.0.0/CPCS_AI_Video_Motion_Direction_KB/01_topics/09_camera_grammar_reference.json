        "secondary_motion",
        "camera_motion"
      ]
    },
    {
      "id": "dramatic_zoom",
      "parameters": [
        "fov_start",
        "fov_end",
        "frames",
        "easing"
      ]
    },
    {
      "id": "freeze_frame",
      "parameters": [
        "frames",
        "audio_continuation",
        "graphic_treatment"
      ]
    }
  ],
  "model_compilation": {
    "precedence": [
      "camera_reference_or_trajectory",
      "keyframes",
      "documented_camera_enum",
      "prompt_phrase",
      "postprocess"
    ],
    "unsupported": "retain canonical plan, emit lossy-compilation warning, generate prompt approximation"
  },
  "prompt_example": {
    "canonical": "medium-full two-shot; 28mm equivalent; lateral truck 1.4m over 2.0s; preserve axis; impact 1.25s; six-frame damped camera response; 180° shutter; focus on lead actor",
    "prose": "A stable medium-full two-shot tracks laterally beside both fighters, preserving screen direction. At contact add one brief damped handheld jolt, then settle immediately; keep feet and contact readable."
  },
