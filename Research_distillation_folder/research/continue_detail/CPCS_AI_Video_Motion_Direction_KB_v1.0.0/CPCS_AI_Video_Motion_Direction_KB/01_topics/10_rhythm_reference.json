{
  "schema_version": "1.0.0",
  "topic_id": "T10",
  "title": "Rhythm Layer for Motion Sequencing",
  "status": "curated",
  "principle": "Represent rhythm as clock, beat grid, phrase, action phases, accents, and frame-level deviation. Music is optional; all movement still has cadence.",
  "time_representation": {
    "master_clock": "seconds",
    "frame_clock": "integer frame + fps",
    "musical_clock": "bar:beat:subdivision + tempo map",
    "conversion": "seconds_per_beat=60/BPM; frame=round(seconds*fps)",
    "policy": "retain continuous time and derive frames once; avoid repeated rounding",
    "source_ids": [
      "S013",
      "S041",
      "S045"
    ]
  },
  "components": {
    "tempo_bpm": "number|null",
    "tempo_curve": "time-varying BPM/action rate",
    "cadence": "event interval distribution",
    "meter": "optional beats/subdivision",
    "beat_phase": "[0,1)",
    "syncopation": "accent displacement",
    "micro_pause_s": "local hold within phrase",
    "anticipation_beats": "lead to focal event",
    "accent_strength": "[0,1]",
    "density": "events/sec or beat",
    "swing_ratio": "alternating subdivision ratio",
    "rubato": "local timing deviation",
    "entrainment_strength": "actor/music alignment [0,1]",
    "phase_lock": "event-to-cue binding"
  },
  "hierarchy": [
    "sequence",
    "scene",
    "phrase",
    "exchange",
    "action",
    "phase",
    "micro_event",
    "frame"
  ],
