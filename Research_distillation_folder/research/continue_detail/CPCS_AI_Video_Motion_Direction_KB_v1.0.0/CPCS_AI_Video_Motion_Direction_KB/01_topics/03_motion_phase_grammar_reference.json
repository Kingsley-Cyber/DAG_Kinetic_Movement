  "canonical_phases": [
    {
      "id": "initiation",
      "order": 1,
      "purpose": "first observable or inferred commitment",
      "optional": true,
      "carries": [
        "intent",
        "attention shift",
        "deception setup"
      ],
      "provenance": "CPCS synthesis"
    },
    {
      "id": "preparation",
      "order": 2,
      "purpose": "organize support, alignment, backswing, guard, anticipation",
      "optional": true,
      "carries": [
        "readability",
        "feint information",
        "pre-tension"
      ],
      "provenance": "gesture preparation + animation anticipation + biomechanics"
    },
    {
      "id": "acceleration",
      "order": 3,
      "purpose": "increase linear/angular velocity toward focal event",
      "optional": false,
      "carries": [
        "force development",
        "urgency",
        "commitment"
      ],
      "provenance": "biomechanical action phase"
    },
    {
      "id": "stroke",
      "order": 4,
      "purpose": "meaning-bearing apex, target acquisition, or contact",
      "optional": false,
      "carries": [
        "semantic payload",
        "contact",
        "emotion accent"
      ],
      "provenance": "Kendon/McNeill gesture stroke + action apex"
    },
    {
      "id": "overshoot",
      "order": 5,
      "purpose": "post-apex continuation due to momentum/follow-through/exaggeration",
      "optional": true,
      "carries": [
        "perceived force",
        "style exaggeration"
      ],
      "provenance": "animation + biomechanics"
    },
    {
      "id": "recovery",
      "order": 6,
      "purpose": "retract, recoil, redirect, or return toward stable organization",
      "optional": true,
      "carries": [
        "defensive readiness",
        "recoil",
        "aftereffect"
      ],
      "provenance": "gesture retraction/BML relax-to-end"
    },
    {
      "id": "settle",
      "order": 7,
      "purpose": "dissipate residual motion and establish next stable state",
      "optional": true,
      "carries": [
        "weight resolution",
        "secondary motion",
        "reaction beat"
      ],
      "provenance": "CPCS production phase"
    }
  ],
