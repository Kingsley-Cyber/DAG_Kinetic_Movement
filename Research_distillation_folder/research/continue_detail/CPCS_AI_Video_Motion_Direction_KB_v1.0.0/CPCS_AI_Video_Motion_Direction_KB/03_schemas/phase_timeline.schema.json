{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cpcs/schema/phase_timeline/1.0.0",
  "title": "CPCS Phase Timeline",
  "type": "object",
  "properties": {
    "timeline_id": {
      "type": "string"
    },
    "action_id": {
      "type": "string"
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase_id": {
            "enum": [
              "initiation",
              "preparation",
              "acceleration",
              "stroke",
              "overshoot",
              "recovery",
              "settle",
              "hold",
              "custom"
            ]
          },
          "custom_label": {
            "type": "string"
          },
          "t_start_s": {
            "type": "number",
            "minimum": 0
          },
          "t_end_s": {
            "type": "number",
            "minimum": 0
          },
          "progress_curve": {
            "type": "string"
          },
          "semantic_role": {
            "type": "string"
          },
          "force_role": {
            "type": "string"
          },
          "emotion_role": {
            "type": "string"
          },
          "contact_event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "phase_id",
          "t_start_s",
          "t_end_s"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "interruptions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "provenance_class": {
          "enum": [
            "ESTABLISHED",
            "EMPIRICAL",
            "PRACTICE",
            "CPCS_CONVENTION",
            "UNVERIFIED"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{3}$"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "measurement_status": {
          "enum": [
            "measured",
            "annotated",
            "inverse_dynamics_estimate",
            "model_inference",
            "visual_proxy",
            "prompt_prior",
            "generated"
          ]
        },
        "uncertainty_note": {
          "type": "string"
        }
      },
      "required": [
        "provenance_class"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "timeline_id",
    "duration_s",
    "phases"
  ],
  "unevaluatedProperties": false
}
